#ifndef __LANGLIBS_NULLABLE_DEF__
#define __LANGLIBS_NULLABLE_DEF__

#include<pointer>

/** @file */

namespace lang {

  /**
    @class nullable
    @brief Functionally similar to `std::optional`. However, this class is built with
    `lang::pointer`. This class also has simpler and fewer methods than `std::optional`,
    yet maintains all the functionalities

    `nullable` preserves the pointer to the value in assignement operators

    Supports both regular and thread safe variants of the nullable. By default,
    the nullable is not thread safe. The thread safe instance can be created by passing
    `true` as second template argument. Example:
    @code{.cpp}
    nullable<T> p; // this creates regular nullable that is not thread safe
    nullable<T, true> p; // this creates thread safe nullable
    @endcode
    `concurrent_nullable<T>` is an alias to `nullable<T, true>`

    Though concurrent_nullable is thread safe with respect to the reference to the value,
    if the value is mutable, concurrent updates to the value may have thread safety
    issues. It is the responsibility of the value class to implement thread safety.
   */
  template<typename T, bool ThreadSafe = false>
  class nullable {
    public:
      /**
        @brief Constructs null nullable object
       */
      nullable();

      /**
        @brief Constructs nullable object for the object referred by the pointer
        @param ptr - Pointer that holds the value for the nullable
       */
      explicit nullable(const pointer<T, ThreadSafe>& ptr);

      /**
        @brief Returns refernce to the value from constant nullable
        @return Reference to the value that nullable has
        @throw nullpointer_error Throws null pointer error when there is nullable is null
       */
      const T& operator *() const;

      /**
        @brief Returns refernce to the value.
        @return Reference to the value that nullable has
        @throw nullpointer_error Throws null pointer error when there is nullable is null

        This should be used with caution. It returns a mutable value. Updates to the value
        in a multi-thread environment can still cause thread safety issues. The thread
        safety should be handled by the class implementation of the value.
        Unless there is a need to update the value, the explicit cast operator is
        preferred which returns the copy of the value
       */
      T& operator *();

      /**
        @brief Returns the copy of the value
        @return Copy of the value that nullable has
       */
      explicit operator T() const;

      /**
        @brief Checks if the nullable has a non-null object
        @retval true - if nullable has non-null value
        @retval false - if nullable has no value
       */
      bool isnull() const;

      /**
        @brief Convenience method equivalent to `not isnull()`
        @retval true - if nullable has value
        @retval false - if nullable has no value
       */
      operator bool() const;

      /**
        @brief Returns the value if nullable has a value; otherwise returns the value
        passed in the argument
        @param value - Default value to be returned if nullable is null
        @return Returns the immutable object copy constructed either from nullable value
        or from the value passed in the argument

        This is equivalent of:
        @code{.cpp}
        mynullable? *mynullable : default_value;
        @endcode
       */
      T or_else(const T& value) const;

      /**
        @brief Returns the value if nullable has a value; otherwise returns the value
        returned by the argument function. This returns a immutable object
        @param func - Function that returns type `T` and takes no argument
        @return Returns the immutable object copy constructed either from nullable value
        or from the function return value

        This is equivalent of:
        @code{.cpp}
        mynullable? *mynullable : getter_function();
        @endcode
       */
      T or_else(std::function<T()> func) const;

      /**
        @brief Throws exception if nullable doesn't have value; otherwise return nullable
        value
        @param args requires to construct exception object
        @throw exception of type specified in the template
       */
      template<typename E, typename... EArgs>
      T or_throw(EArgs... args);

    private:
      static_assert(std::is_copy_constructible<T>::value
          and std::is_copy_assignable<T>::value,
        "Template type should have copy constructor and copy assignment");
      pointer<T, ThreadSafe> _ptr;
  };

  template<typename T>
  using concurrent_nullable = nullable<T, true>;

}; //namespace lang

#include<impl/nullable.hpp>

#endif //__LANGLIBS_NULLABLE_DEF__
