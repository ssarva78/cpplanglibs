#ifndef __LANGLIBS_NULLABLE_DEF__
#define __LANGLIBS_NULLABLE_DEF__

#include<pointer>

/** @file */

namespace lang {

  /**
    @class nullable
    @brief Functionally similar to `std::optional`. However, this class is built with
    `lang::pointer`. This class also has simpler and fewer methods than `std::optional`,
    yet maintains all the functionalities

    The type of the value object stored in nullable should have both copy constructor and
    copy assignment operators - either default or custom implemented

    `nullable` preserves the pointer to the value in assignement operators

    Supports both regular and thread safe variants of the nullable. By default,
    the nullable is not thread safe. The thread safe instance can be created by passing
    `true` as second template argument. Example:
    @code{.cpp}
    nullable<T> p; // this creates regular nullable that is not thread safe
    nullable<T, true> p; // this creates thread safe nullable
    @endcode
    `concurrent_nullable<T>` is an alias to `nullable<T, true>`

    Though concurrent_nullable is thread safe with respect to reference to the value,
    if the value is mutable, concurrent updates to the value may have thread safety
    issues. It is the responsibility of the value class to implement thread safety.
   */
  template<typename T, bool ThreadSafe = false> class nullable;

  /**
    @brief Type trait that returns false if the template type is not nullable type
   */
  template<typename C>
  struct is_nullable_type : std::false_type {};

  /**
    @brief Type trait that returns true if the template type is nullable type
   */
  template<typename C>
  struct is_nullable_type<nullable<C, false>> : std::true_type {};

  /**
    @brief Type trait that returns true if the template type is concurrent_nullable type
   */
  template<typename C>
  struct is_nullable_type<nullable<C, true>> : std::true_type {};

  template<typename T, bool ThreadSafe>
  class nullable {
    public:
      /**
        @brief Constructs empty nullable object
       */
      nullable();

      /**
        @brief Constructs nullable object for the object referred by the pointer
        @param ptr - Pointer that holds the value for the nullable
       */
      explicit nullable(const pointer<T, ThreadSafe>& ptr);

      /**
        @brief Returns constant reference to the value from nullable
        @return Reference to the value that nullable has
        @throw nullpointer_error Throws null pointer error when nullable is empty
       */
      const T& operator *() const;

      /**
        @brief Returns reference to the value.
        @return Reference to the value that nullable has
        @throw nullpointer_error Throws null pointer error when nullable is empty

        This should be used with caution. It returns a mutable value. Updates to the value
        in a multi-thread environment can still cause thread safety issues. The thread
        safety should be handled by the `value` class implementation.
        Unless there is a need to update the value, the cast operator `const T&` is
        preferred which returns constant reference to the value
       */
      T& operator *();

      /**
        @brief Returns constant reference to the value. This is preferred over
        `operator *()` unless there is a need to modify the value
        @return constant reference to the value that nullable has
        @throw nullpointer_error Throws null pointer error when nullable is empty
       */
      operator const T&() const;

      /**
        @brief Returns the lang::pointer to the value.
        @return lang::pointer to the value
       */
      const pointer<T, ThreadSafe>& operator &() const;

      /**
        @brief Checks if the nullable has a non-null object
        @retval true - if nullable has non-null value
        @retval false - if nullable has no value
       */
      bool isnull() const;

      /**
        @brief Returns the value if nullable has a value; otherwise returns the value
        passed in the argument
        @param value - Default value to be returned if nullable is empty
        @return Returns the immutable object copy constructed either from nullable value
        or from the value passed in the argument

        This is equivalent of:
        @code{.cpp}
        mynullable.isnull()? default_value : *mynullable; 
        @endcode

        Caution should be applied while using this method when the argument is passed as
        function call. The function call in the argument is always called even if the
        nullable has value which is unnecessary.

        Instead of the below usage, it is more efficient to use with ?: operator
        @code{.cpp}
        mynullable.or_else(func(...));
        @endcode

        However, this doesn't apply when the function pointer is passed in the argument
        in the below method. In this case, the function is called only when nullable is
        null.
        @code{.cpp}
        T or_else(std::function<T()>&& func) const;
        @endcode

       */
      T or_else(const T& value) const;

      /**
        @brief Returns the value if nullable has a value; otherwise returns the value
        returned by the argument function. This returns a immutable object
        @param func - Function that returns type `T` and takes no argument
        @return Returns the immutable object copy constructed either from nullable value
        or from the function return value

        This is equivalent of:
        @code{.cpp}
        mynullable.isnull()? func() : *mynullable;
        @endcode
       */
      T or_else(std::function<T()>&& func) const;

      /**
        @brief Throws exception if nullable doesn't have value; otherwise return nullable
        value
        @param args requires to construct exception object
        @throw exception of type specified in the template
       */
      template<typename E, typename... EArgs>
      T or_throw(EArgs... args);

      /**
        @brief If the value is present, invokes the function on the value; otherwise return
        an empty nullable
        @param func The function to be invoked on the value. The function should return a
        nullable
        @return nullable
       */
      template<typename F>
      auto map(F&& func) const;

    private:
      static_assert(std::is_copy_constructible<T>::value
          and std::is_copy_assignable<T>::value,
        "Template type should have copy constructor and copy assignment");
      static_assert(!is_nullable_type<T>::value,
        "Nested nullable is not allowed");
      static_assert(!std::is_pointer<T>::value,
        "Template type cannot be a pointer");
      pointer<T, ThreadSafe> _ptr;
  };

  template<typename T>
  using concurrent_nullable = nullable<T, true>;

}; //namespace lang

#include<impl/nullable.hpp>

#endif //__LANGLIBS_NULLABLE_DEF__
